# Supabase — .env.local ga nusxa oling va qiymatlarni to'ldiring.
# (.env.local git ga kirmaydi — maxfiy kalitlar xavfsiz.)

# Loyiha sozlamalari → API dan:
NEXT_PUBLIC_SUPABASE_URL=https://<loyiha-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Faqat SERVERDA ishlatiladi (savol baholash, admin). Hech qachon mijozga chiqmaydi!
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>

# Ma'lumotlar bazasi (import/migratsiya skriptlari uchun) — Transaction pooler (port 6543):
# Loyiha → Database → Connection string → "Transaction" (Supavisor)
DATABASE_URL=postgresql://postgres.<ref>:<parol>@aws-0-<region>.pooler.supabase.com:6543/postgres
